{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "CeibaAssets.Api"
    }
  },
  "Hosting": {
    "PathBase": ""
  },
  "OpenApi": {
    "Enabled": false
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "WindowSeconds": 60
  },
  "AllowedHosts": "localhost"
}
