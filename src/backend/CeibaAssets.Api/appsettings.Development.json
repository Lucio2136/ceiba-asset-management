{
  "Serilog": {
    "WriteTo": {
      "Console": {
        "Name": "Console"
      },
      "File": {
        "Name": "File",
        "Args": {
          "path": "logs/ceiba-assets-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    }
  },
  "Hosting": {
    "PathBase": "/api"
  },
  "OpenApi": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "CeibaAssets": "Server=.\\SQLEXPRESS;Database=CeibaAssets;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Seed": {
    "AdminEmail": "admin@ceiba.example"
  }
}
