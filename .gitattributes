# Normaliza finales de línea en el repositorio. Los archivos de texto se guardan con LF.
* text=auto eol=lf

# Scripts nativos de Windows requieren CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.sln text eol=crlf

# Binarios.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.dll binary
*.exe binary

# Código generado: se excluye de estadísticas y se colapsa en diffs de GitHub.
src/frontend/ceiba-assets-web/src/app/core/http/generated/** linguist-generated=true
src/backend/CeibaAssets.Api/OpenApi/*.json linguist-generated=true
**/packages.lock.json linguist-generated=true
src/frontend/ceiba-assets-web/package-lock.json linguist-generated=true
